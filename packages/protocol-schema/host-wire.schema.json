{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://seekwd.local/schemas/host-wire-0.1.json",
  "title": "HostWire",
  "description": "Current local Host HTTP slice only; not the complete domain contract.",
  "oneOf": [
    { "$ref": "#/definitions/HostSnapshot" },
    { "$ref": "#/definitions/HostEventBatch" },
    { "$ref": "#/definitions/HostError" },
    { "$ref": "#/definitions/StartRunRequest" },
    { "$ref": "#/definitions/SubmitRunInputRequest" },
    { "$ref": "#/definitions/SaveRevisionRequest" },
    { "$ref": "#/definitions/CreateNodeRequest" },
    { "$ref": "#/definitions/CreateEdgeRequest" },
    { "$ref": "#/definitions/CreatePortRequest" },
    { "$ref": "#/definitions/UpdateNodeRequest" }
  ],
  "definitions": {
    "RunStatus": { "type": "string", "enum": ["idle", "queued", "running", "waiting_input", "succeeded", "failed"] },
    "Workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "path", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "path": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "workspaceId", "name", "status", "defaultEntrypointNodeId", "revision", "draftRevision", "draftDirty", "updatedAt"],
      "properties": {
        "id": { "type": "string" },
        "workspaceId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "$ref": "#/definitions/RunStatus" },
        "defaultEntrypointNodeId": { "type": ["string", "null"] },
        "revision": { "type": "integer", "minimum": 0 },
        "draftRevision": { "type": "integer", "minimum": 0 },
        "draftDirty": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "CanvasNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canvasId", "name", "kind", "ports"],
      "properties": {
        "id": { "type": "string" },
        "canvasId": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "ports": { "type": "array", "items": { "$ref": "#/definitions/CanvasPort" } },
        "config": { "type": "object", "additionalProperties": true }
      }
    },
    "CanvasPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "nodeId", "name", "direction", "kind"],
      "properties": {
        "id": { "type": "string" },
        "nodeId": { "type": "string" },
        "name": { "type": "string" },
        "direction": { "type": "string", "enum": ["input", "output"] },
        "kind": { "type": "string", "enum": ["data", "flow", "event", "resource"] }
      }
    },
    "CanvasEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canvasId", "sourceNodeId", "sourcePortId", "targetNodeId", "targetPortId", "kind"],
      "properties": {
        "id": { "type": "string" },
        "canvasId": { "type": "string" },
        "sourceNodeId": { "type": "string" },
        "sourcePortId": { "type": "string" },
        "targetNodeId": { "type": "string" },
        "targetPortId": { "type": "string" },
        "kind": { "type": "string", "enum": ["data", "flow", "event", "resource"] }
      }
    },
    "CanvasRevision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canvasId", "revision", "createdAt", "createdBy", "status", "contentDigest", "graphJson"],
      "properties": {
        "id": { "type": "string" },
        "canvasId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string", "enum": ["user", "agent"] },
        "status": { "type": "string", "enum": ["validated", "debug"] },
        "contentDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "graphJson": { "type": "string", "minLength": 2 }
      }
    },
    "Run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "canvasId", "revision", "status", "startedAt", "finishedAt"],
      "properties": {
        "id": { "type": "string" },
        "canvasId": { "type": "string" },
        "revision": { "type": "integer", "minimum": 0 },
        "status": { "$ref": "#/definitions/RunStatus" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": ["string", "null"] },
        "currentNodeId": { "type": ["string", "null"] },
        "inputPrompt": { "type": ["string", "null"] },
        "result": { "type": ["string", "null"] },
        "completedNodeIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "message", "severity", "createdAt", "runId", "canvasId"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "success", "warning", "error"] },
        "createdAt": { "type": "string" },
        "runId": { "type": ["string", "null"] },
        "canvasId": { "type": ["string", "null"] }
      }
    },
    "HostSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshotVersion", "workspaces", "canvases", "nodes", "edges", "revisions", "runs", "notifications"],
      "properties": {
        "snapshotVersion": { "type": "integer", "minimum": 0 },
        "workspaces": { "type": "array", "items": { "$ref": "#/definitions/Workspace" } },
        "canvases": { "type": "array", "items": { "$ref": "#/definitions/Canvas" } },
        "nodes": { "type": "array", "items": { "$ref": "#/definitions/CanvasNode" } },
        "edges": { "type": "array", "items": { "$ref": "#/definitions/CanvasEdge" } },
        "revisions": { "type": "array", "items": { "$ref": "#/definitions/CanvasRevision" } },
        "runs": { "type": "array", "items": { "$ref": "#/definitions/Run" } },
        "notifications": { "type": "array", "items": { "$ref": "#/definitions/Notification" } }
      }
    },
    "HostEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "eventType", "globalPosition", "snapshotVersion", "occurredAt"],
      "properties": {
        "eventId": { "type": "string" },
        "eventType": { "type": "string", "const": "projection.snapshot.updated" },
        "globalPosition": { "type": "integer", "minimum": 0 },
        "snapshotVersion": { "type": "integer", "minimum": 0 },
        "occurredAt": { "type": "string" }
      }
    },
    "HostEventBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["events", "nextGlobalPosition", "snapshotVersion"],
      "properties": {
        "events": { "type": "array", "items": { "$ref": "#/definitions/HostEvent" } },
        "nextGlobalPosition": { "type": "integer", "minimum": 0 },
        "snapshotVersion": { "type": "integer", "minimum": 0 }
      }
    },
    "HostError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "retryable": { "type": "boolean" }
      }
    },
    "StartRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "idempotencyKey"],
      "anyOf": [
        {
          "required": ["entrypoint"],
          "properties": { "entrypoint": { "type": "string", "const": "default" } }
        },
        {
          "required": ["entrypointId"],
          "properties": { "entrypointId": { "type": "string", "minLength": 1 } }
        }
      ],
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "entrypoint": { "type": "string", "const": "default" },
        "entrypointId": { "type": "string", "minLength": 1 },
        "idempotencyKey": { "type": "string", "minLength": 1 }
      }
    },
    "SubmitRunInputRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": { "type": "string" }
      }
    },
    "SaveRevisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedDraftRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "CreateNodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "CreateEdgeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceNodeId", "sourcePortId", "targetNodeId", "targetPortId", "kind"],
      "properties": {
        "sourceNodeId": { "type": "string" },
        "sourcePortId": { "type": "string" },
        "targetNodeId": { "type": "string" },
        "targetPortId": { "type": "string" },
        "kind": { "type": "string", "enum": ["data", "flow", "event", "resource"] }
      }
    },
    "CreatePortRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "direction": { "type": "string", "enum": ["input", "output"] },
        "kind": { "type": "string", "enum": ["data", "flow", "event", "resource"] }
      }
    },
    "UpdateNodeRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "config": { "type": "object", "additionalProperties": true }
      },
      "minProperties": 1
    }
  }
}
